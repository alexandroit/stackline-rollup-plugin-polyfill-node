{
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "node",
    "module": "ES2020",
    "target": "es2018",
    "lib": ["ES2023", "DOM", "ESNext.Disposable"],
    "declaration": true,
    "outDir": "lib",
    "declarationDir": "dist",
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src"
  ]
}
